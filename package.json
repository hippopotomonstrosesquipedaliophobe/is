    "@rollup/plugin-typescript": "^12.3.1",
    "@types/node": "^25.9.9",
    "@vvi/check-version": "^1.1.3",
    "@vvi/copy-text": "^1.1.3",
    "@vvi/node": "^5.2.0",
    "@vvi/pen": "^3.0.5",
    "@vvi/rollup-external": "^1.2.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.9.0",
    "globals": "^17.14.0",
